# Copy this file to .env for local development. Replace these placeholders.
# These credentials are for a local development environment only.
MONGO_INITDB_ROOT_USERNAME=devadmin
MONGO_INITDB_ROOT_PASSWORD=change-this-local-password
MONGO_EXPRESS_USERNAME=devadmin
MONGO_EXPRESS_PASSWORD=change-this-admin-ui-password

# Optional host ports
API_PORT=3000
MONGO_EXPRESS_PORT=8081
REDISINSIGHT_PORT=5540
