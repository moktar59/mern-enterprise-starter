# Copy this file to .env for local development. Replace these placeholders.
# Local development only; never reuse these credentials in shared or production environments.
MONGO_INITDB_ROOT_USERNAME=devadmin
MONGO_INITDB_ROOT_PASSWORD=change-this-local-password
MONGO_EXPRESS_USERNAME=devadmin
MONGO_EXPRESS_PASSWORD=change-this-admin-ui-password

# Optional host ports
API_PORT=3000
MONGO_EXPRESS_PORT=8081
REDISINSIGHT_PORT=5540

# Local example only; generate a unique key with openssl rand -base64 32
AUTH_JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes

# Argon2id work-factor settings (defaults shown; tune using deployment capacity and latency tests)
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_MEMORY_COST_KIB=19456
AUTH_ARGON2_PARALLELISM=1
